# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=WARNING

# Database (Docker service name as host)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong-random-password-here
POSTGRES_DB=servicehub
DATABASE_URL=postgresql+asyncpg://postgres:strong-random-password-here@postgres:5432/servicehub

# Redis (Docker service name as host)
REDIS_URL=redis://redis:6379/0

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS — set to your actual frontend domain(s)
ALLOWED_ORIGINS=https://yourdomain.com

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads/
